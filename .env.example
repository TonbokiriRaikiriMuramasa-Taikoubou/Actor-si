# Actor の設定例。このファイルを .env にコピーして使う。
# 優先度: コマンドライン引数 > 環境変数 > .env

# ------------------------------------------------------------------
# Gemini API（Google AI Studio で発行したキー）
# https://aistudio.google.com/apikey
# 未設定のままだと内蔵シミュレータ（モック）で動作します。
# ------------------------------------------------------------------
# ここに貼るのがいちばん分かりやすい置き場所（このファイルは .gitignore 済み）。
# UI の 🔑 や `python3 -m actor key set` でも保存できます（保存先: .actor/api_key）。
# 優先度: --api-key > 環境変数 > この .env > .actor/api_key > .actor/keys/*
GEMINI_API_KEY=

# ------------------------------------------------------------------
# 複数のキー（無料枠の 429 対策・自動ローテーション）
# ------------------------------------------------------------------
# カンマ / 空白 / セミコロン区切りで複数書けます。1 本が 429（Quota exceeded）になったら
# 自動で次のキーへ切り替えます（`actor key list` で状態、`actor key check` で生存確認）。
# ファイルで持ちたいときは `actor key add`（.actor/keys/key-1.key … に 1 本ずつ保存）か
# `actor key add --env`（この .env の GEMINI_API_KEYS に追記）。
# GEMINI_API_KEYS=AIza...,AIza...,AIza...
#
# 429 のあと、そのキーを避ける秒数（既定 60）
ACTOR_KEY_COOLDOWN=60
# 自動で切り替える（false にすると従来どおり同じキーでリトライだけ）
ACTOR_KEY_ROTATE=true
# 複数キーを置くフォルダ（既定: <data_dir>/keys）
# ACTOR_KEYS_DIR=./.actor/keys
# 429 でよく切れるキー / モデルは `actor key stats`、キーの入手先は `actor key sources`

# auto = キーがあれば Gemini、無ければシミュレータ / gemini / genai / mock
ACTOR_PROVIDER=auto

# キーがあるときの実装。gemini = urllib 直叩き（依存なし・既定） / genai = 公式 SDK
# genai を使うには: pip install google-genai
ACTOR_GEMINI_IMPL=gemini

# 使用モデル
ACTOR_MODEL=gemini-3-flash
# 例: gemini-3-pro / gemini-3.5-flash / gemini-2.5-flash / gemini-2.5-pro

# 429（枠切れ）が続いたときにだけ使う逃げ道。枠はモデルごとに別なので、これで会話が続きます。
# 空文字（ACTOR_MODEL_FALLBACKS=）で無効化。--fallback-model / --no-model-fallback でも切り替え可。
ACTOR_MODEL_FALLBACKS=gemini-3.5-flash,gemini-2.5-flash

# Vertex AI エクスプレスモード（APIキーで使える別枠・新規 GCP ユーザーは 90 日無料）を使うときは、
# ACTOR_BASE_URL=https://aiplatform.googleapis.com
# を設定するだけで OK（API の形は自動で v1 / publishers/google/models/{model} に変わります）。
# ACTOR_API_VERSION=v1
# ACTOR_MODEL_PATH=publishers/google/models/{model}

# ------------------------------------------------------------------
# 生成パラメータ
# ------------------------------------------------------------------
ACTOR_TEMPERATURE=0.7
ACTOR_TOP_P=0.95
ACTOR_MAX_OUTPUT_TOKENS=4096
# 思考（thinkingConfig）のトークン予算。0 で無効。例: 1024
ACTOR_THINKING_BUDGET=0
ACTOR_STREAM=true

# ------------------------------------------------------------------
# スキル
# ------------------------------------------------------------------
# スキルフォルダ（複数指定は os.pathsep / カンマ区切り）
ACTOR_SKILLS_DIR=./skills
# 依頼文からの自動選択
ACTOR_AUTO_SELECT=true
ACTOR_MAX_AUTO_SKILLS=3
ACTOR_AUTO_SELECT_THRESHOLD=2.0
# system_instruction に埋め込む参照テキストの上限（文字数）
ACTOR_INLINE_REFERENCE_LIMIT=24000

# ------------------------------------------------------------------
# サーバー / 保存先
# ------------------------------------------------------------------
ACTOR_DATA_DIR=./.actor
ACTOR_HOST=127.0.0.1
ACTOR_PORT=8080
ACTOR_LOG_LEVEL=info

# 動作確認用（シミュレータの応答速度・秒/チャンク）。0 で最速。
# ACTOR_MOCK_DELAY=0.012

# ------------------------------------------------------------------
# 道具（function calling）
# モデルが自分で呼び出せる道具。カンマ区切りで有効化する。
# 既定: now,read_file,list_files,list_skills,read_skill（読み取りのみ）
# write_file / http_get は下の ALLOW_* を true にしたときだけ使える（危険）
# ------------------------------------------------------------------
ACTOR_TOOLS=now,read_file,list_files,list_skills,read_skill
# 読み書きできる範囲（サンドボックス）。既定はカレントディレクトリ
ACTOR_TOOLS_ROOT=.
ACTOR_TOOLS_ALLOW_WRITE=false
ACTOR_TOOLS_ALLOW_NETWORK=false
ACTOR_TOOLS_TIMEOUT=15
# 1ターンでツールを往復する回数（最後の1回は答えを書くために残す）
ACTOR_MAX_TOOL_ROUNDS=4

# ------------------------------------------------------------------
# 添付（画像 / PDF）
# ------------------------------------------------------------------
ACTOR_MAX_ATTACHMENT_MB=10
ACTOR_MAX_ATTACHMENTS=6
# セッション / ルームの JSON に base64 を保存するか（false なら当該ターンのみ）
ACTOR_STORE_ATTACHMENTS=true

# ------------------------------------------------------------------
# ルームの保護と Webhook（常駐ボットを外から叩くとき）
# ------------------------------------------------------------------
# 設定時はすべての /api/* endpoint に必要。LAN / 外部 bind では必須
# ACTOR_ROOM_TOKEN=replace-with-a-long-random-token
# Required when ACTOR_HOST is not loopback; protects every /api/* endpoint.
# ACTOR_CORS_ORIGINS=https://your.example
# ACTOR_ALLOWED_HOSTS=actor.example.com
ACTOR_ROOM_PROTECT_READS=false
# 発言があったら外部へ POST する（X-Actor-Signature: sha256=... 付き）
# ACTOR_WEBHOOK_URL=https://example.com/actor-hook
# ACTOR_WEBHOOK_SECRET=change-me
ACTOR_WEBHOOK_EVENTS=message
ACTOR_WEBHOOK_TIMEOUT=10

# UI / CLI が保存したキーの置き場（既定: <data_dir>/api_key）
# ACTOR_API_KEY_FILE=./.actor/api_key

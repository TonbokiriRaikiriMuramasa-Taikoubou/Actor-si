# Example Actor configuration. Copy this file to .env and configure it locally.
# Precedence: CLI options > environment variables > .env

# ------------------------------------------------------------------
# Gemini API credentials
# Obtain a credential from the provider and keep its value out of source control.
# If unset, Actor uses its built-in simulator.
# You can also save a credential through the UI or `python3 -m actor key set`.
# Precedence: --api-key > environment > this .env > .actor/api_key > .actor/keys/*
GEMINI_API_KEY=

# ------------------------------------------------------------------
# Multiple credentials (automatic rotation after 429 responses)
# Use comma-, whitespace-, or semicolon-separated values in your local .env.
# Actor cools down a limited credential and tries the next available one.
# For file-based storage use `actor key add`; use `actor key add --env` to edit this file.
# Keep credential values local; do not add them to this tracked example.
# GEMINI_API_KEYS=

# Seconds to avoid a credential after a rate limit (default: 60)
ACTOR_KEY_COOLDOWN=60
# Rotate to another credential after rate limits and authorization errors
ACTOR_KEY_ROTATE=true
# Directory for individual credential files (default: <data_dir>/keys)
# ACTOR_KEYS_DIR=./.actor/keys
# Use `actor key stats` to inspect rate limits and `actor key sources` for provider options.

# auto = Gemini when credentials are available, simulator otherwise; also supports gemini / genai / mock
ACTOR_PROVIDER=auto

# Provider implementation: gemini = standard-library REST (default); genai = optional official SDK
# Install the optional SDK with: pip install google-genai
ACTOR_GEMINI_IMPL=gemini

# Model name
ACTOR_MODEL=gemini-3-flash
# Other examples: gemini-3-pro / gemini-3.5-flash / gemini-2.5-flash / gemini-2.5-pro

# Models to try if the primary model is rate-limited; quotas are model-specific.
# Set ACTOR_MODEL_FALLBACKS to an empty value to disable; CLI overrides are also available.
ACTOR_MODEL_FALLBACKS=gemini-3.5-flash,gemini-2.5-flash

# Vertex AI Express Mode uses a separate API endpoint; Actor detects its API shape automatically.
# ACTOR_BASE_URL=https://aiplatform.googleapis.com
# ACTOR_API_VERSION=v1
# ACTOR_MODEL_PATH=publishers/google/models/{model}

# ------------------------------------------------------------------
# Generation parameters
# ------------------------------------------------------------------
ACTOR_TEMPERATURE=0.7
ACTOR_TOP_P=0.95
ACTOR_MAX_OUTPUT_TOKENS=4096
# Thinking token budget; 0 disables thinking configuration.
ACTOR_THINKING_BUDGET=0
ACTOR_STREAM=true

# ------------------------------------------------------------------
# Skills
# ------------------------------------------------------------------
# Skill directories; multiple paths can be separated with the platform path separator or commas.
ACTOR_SKILLS_DIR=./skills
# Select skills automatically from each request.
ACTOR_AUTO_SELECT=true
ACTOR_MAX_AUTO_SKILLS=3
ACTOR_AUTO_SELECT_THRESHOLD=2.0
# Maximum reference text included in system instructions (characters).
ACTOR_INLINE_REFERENCE_LIMIT=24000

# ------------------------------------------------------------------
# Server and data directory
# ------------------------------------------------------------------
ACTOR_DATA_DIR=./.actor
ACTOR_HOST=127.0.0.1
ACTOR_PORT=8080
ACTOR_LOG_LEVEL=info

# Simulator response speed, in seconds per chunk; 0 is fastest.
# ACTOR_MOCK_DELAY=0.012

# ------------------------------------------------------------------
# Tools (function calling)
# The model can call these tools. Comma-separated list.
# Defaults are read-only: now,read_file,list_files,list_skills,read_skill.
# write_file and http_get require the corresponding explicit opt-in below.
# ------------------------------------------------------------------
ACTOR_TOOLS=now,read_file,list_files,list_skills,read_skill
# Filesystem sandbox root; defaults to the current working directory.
ACTOR_TOOLS_ROOT=.
ACTOR_TOOLS_ALLOW_WRITE=false
ACTOR_TOOLS_ALLOW_NETWORK=false
ACTOR_TOOLS_TIMEOUT=15
# Maximum tool rounds per turn; the final round is reserved for the response.
ACTOR_MAX_TOOL_ROUNDS=4

# ------------------------------------------------------------------
# Attachments (images / PDFs)
# ------------------------------------------------------------------
ACTOR_MAX_ATTACHMENT_MB=10
ACTOR_MAX_ATTACHMENTS=6
# Store base64 attachment data in session/room JSON; false keeps it for the current turn only.
ACTOR_STORE_ATTACHMENTS=true

# ------------------------------------------------------------------
# Room protection and webhooks
# ------------------------------------------------------------------
# Set a strong locally generated value before binding beyond loopback.
# When set, this credential is required for every /api/* endpoint.
# ACTOR_ROOM_TOKEN=
# ACTOR_CORS_ORIGINS=https://trusted.example
# ACTOR_ALLOWED_HOSTS=actor.example.com
ACTOR_ROOM_PROTECT_READS=false
# Optional asynchronous notifications; keep the signing secret in a local secret store.
# ACTOR_WEBHOOK_URL=https://example.com/actor-hook
# ACTOR_WEBHOOK_SECRET=
ACTOR_WEBHOOK_EVENTS=message
ACTOR_WEBHOOK_TIMEOUT=10

# Key file written by the UI or CLI (default: <data_dir>/api_key).
# ACTOR_API_KEY_FILE=./.actor/api_key
